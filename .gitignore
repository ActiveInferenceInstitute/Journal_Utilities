# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
2_audio_to_markdown/authkey.txt
venv
.env
history.txt

.coverage

# Audio — large media, never commit (audio lives on the audio branch only)
*.mp3
*.wav
*.m4a
data/output/audio/

# Sensitive: browser cookies extracted by yt-dlp (NEVER commit)
cookies.txt

# Runtime state for the translation watchdog
.translate_tb_watchdog.lock*

# Generated pipeline output (E3): produced by the pipelines, never edited by
# hand — kept in data/ but out of git. Small inputs in data/input/ stay tracked.
data/output/
data/export/

# Logs, OS noise, partial downloads
*.log
*.part
*.ytdl
.DS_Store
